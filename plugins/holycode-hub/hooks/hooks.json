{
  "description": "Session-start convenience check (git conventions, Hub link state, stale AGENTS.md block) and effort capture (HH-133): timestamps of prompts, stops, tool steps and session end on the claimed story, buffered locally as human/AI segments — timestamps, actor and category only. Never a network call, never blocks the session. Story worktrees (HH-90): a work_claim / work_progress / work_verify call renews the recorded lease of its story's worktree.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/effort-capture.mjs\" hook", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/effort-capture.mjs\" hook", "timeout": 5 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/effort-capture.mjs\" hook", "timeout": 5 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/effort-capture.mjs\" hook", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/effort-capture.mjs\" hook", "timeout": 5 }
        ]
      },
      {
        "matcher": "mcp__.*__work_(claim|progress|verify)",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/story-worktree.mjs\" hook", "timeout": 5 }
        ]
      }
    ]
  }
}
